generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Aquí definiremos las tablas de la base de datos
// Ejemplo: Tabla para registrar Voluntarios
model Voluntario {
  id          Int      @id @default(autoincrement())
  nombre          String
  segundoNombre   String?
  apellido        String
  segundoApellido String?
  cedula          String   @unique
  numeroCarnet    String?
  telefono    String?
  especialidad String?
  tipoSangre  String?
  alergias        String?
  fechaNacimiento DateTime?
  direccion       String?
  tallaUniforme   String?
  contactoEmergNombre    String?
  contactoEmergTelefono  String?
  contactoEmergParentesco String?
  activo          Boolean  @default(true)
  fotoUrl         String?
  creadoEn    DateTime @default(now())
  cursos      Curso[]
  usuario     Usuario?
}

model Curso {
  id           Int        @id @default(autoincrement())
  nombre       String
  institucion  String     @default("Cruz Roja")
  fecha        DateTime?
  diplomaUrl   String?
  voluntarioId Int
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  creadoEn     DateTime   @default(now())
}

// Modelo para los administradores y usuarios del sistema
model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Aquí guardaremos la contraseña cifrada
  rol       String   @default("ADMIN") // Ejemplo: ADMIN, DESARROLLADOR, VOLUNTARIO
  creadoEn  DateTime @default(now())
  
  // Relación opcional con el perfil de Voluntario
  voluntarioId Int?       @unique
  voluntario   Voluntario? @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
}

// Modelo para registrar las mejoras e ideas del desarrollador
model Mejora {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  estado      String   @default("Pendiente") // Pendiente, En Progreso, Completado
  creadoEn    DateTime @default(now())
}

// Modelos para Ambulancias e Inventario
model Ambulancia {
  id          Int      @id @default(autoincrement())
  placa       String   @unique
  modelo      String?
  estado      String   @default("Operativa") // Operativa, En Taller, Fuera de Servicio
  creadoEn    DateTime @default(now())
  insumos     InsumoAmbulancia[]
}

model InsumoAmbulancia {
  id              Int        @id @default(autoincrement())
  nombre          String
  cantidad        Int        @default(0)
  categoria       String?    // Medicamentos, Equipos, Material Gastable
  fechaExpiracion DateTime?
  ambulanciaId    Int
  ambulancia      Ambulancia @relation(fields: [ambulanciaId], references: [id], onDelete: Cascade)
  actualizadoEn   DateTime   @updatedAt
}

