generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// AquÃ­ definiremos las tablas de la base de datos
// Ejemplo: Tabla para registrar Voluntarios
model Voluntario {
  id          Int      @id @default(autoincrement())
  nombre          String
  segundoNombre   String?
  apellido        String
  segundoApellido String?
  cedula          String   @unique
  numeroCarnet    String?
  telefono    String?
  especialidad String?
  tipoSangre  String?
  alergias        String?
  fechaNacimiento DateTime?
  direccion       String?
  tallaUniforme   String?
  contactoEmergNombre    String?
  contactoEmergTelefono  String?
  contactoEmergParentesco String?
  activo          Boolean  @default(true)
  fotoUrl         String?
  creadoEn    DateTime @default(now())
  cursos      Curso[]
  usuario     Usuario?
  turnos      TurnoVoluntario[]
  capacitaciones CapacitacionInscripcion[]
  ticketsSoporte TicketSoporte[]
}

model Curso {
  id           Int        @id @default(autoincrement())
  nombre       String
  institucion  String     @default("Cruz Roja")
  fecha        DateTime?
  diplomaUrl   String?
  voluntarioId Int
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  creadoEn     DateTime   @default(now())
}

// Modelo para los administradores y usuarios del sistema
model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // AquÃ­ guardaremos la contraseÃ±a cifrada
  rol       String   @default("ADMIN") // Ejemplo: ADMIN, DESARROLLADOR, VOLUNTARIO
  creadoEn  DateTime @default(now())
  
  // RelaciÃ³n opcional con el perfil de Voluntario
  voluntarioId Int?       @unique
  voluntario   Voluntario? @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  noticias     Noticia[]
}

// Modelo para registrar las mejoras e ideas del desarrollador
model Mejora {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  estado      String   @default("Pendiente") // Pendiente, En Progreso, Completado
  creadoEn    DateTime @default(now())
}

// Modelos para Ambulancias e Inventario
model Ambulancia {
  id          Int      @id @default(autoincrement())
  placa       String   @unique
  modelo      String?
  estado      String   @default("Operativa") // Operativa, En Taller, Fuera de Servicio
  creadoEn    DateTime @default(now())
  insumos     InsumoAmbulancia[]
}

model InsumoAmbulancia {
  id              Int        @id @default(autoincrement())
  nombre          String
  cantidad        Int        @default(0)
  categoria       String?    // Medicamentos, Equipos, Material Gastable
  fechaExpiracion DateTime?
  ambulanciaId    Int
  ambulancia      Ambulancia @relation(fields: [ambulanciaId], references: [id], onDelete: Cascade)
  actualizadoEn   DateTime   @updatedAt
}

// Modelos para Turnos
model Turno {
  id                    Int      @id @default(autoincrement())
  titulo                String
  descripcion           String?
  fechaInicio           DateTime
  fechaFin              DateTime
  ubicacion             String?
  habilidadesRequeridas String?
  cuposMaximos          Int      @default(1)
  estado                String   @default("Abierto") // Abierto, Cancelado, Completado
  creadoEn              DateTime @default(now())
  voluntariosInscritos  TurnoVoluntario[]
}

model TurnoVoluntario {
  id           Int        @id @default(autoincrement())
  turnoId      Int
  voluntarioId Int
  estado       String     @default("Inscrito") // Inscrito, AsistiÃ³, No AsistiÃ³
  creadoEn     DateTime   @default(now())
  turno        Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)

  @@unique([turnoId, voluntarioId])
}

// Modelos para Capacitaciones (Eventos programados por Administrador)
model Capacitacion {
  id                    Int      @id @default(autoincrement())
  titulo                String
  descripcion           String?
  fechaInicio           DateTime
  fechaFin              DateTime
  horaInicio            String   @default("08:00")
  horaFin               String   @default("12:00")
  diasClase             DateTime[]
  ubicacion             String?
  instructor            String?
  cuposMaximos          Int      @default(10)
  estado                String   @default("Programada") // Programada, En Curso, Finalizada, Cancelada
  creadoEn              DateTime @default(now())
  inscripciones         CapacitacionInscripcion[]
}

model CapacitacionInscripcion {
  id               Int          @id @default(autoincrement())
  capacitacionId   Int
  voluntarioId     Int
  estado           String       @default("Inscrito") // Inscrito, AsistiÃ³, No AsistiÃ³, AprobÃ³, ReprobÃ³
  creadoEn         DateTime     @default(now())
  capacitacion     Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  voluntario       Voluntario   @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)

  @@unique([capacitacionId, voluntarioId])
}

// Modelos para Comunidad y Soporte
model Noticia {
  id        Int      @id @default(autoincrement())
  titulo    String
  contenido String
  categoria String   @default("Anuncios") // Anuncios, Actualizaciones, Eventos, Misiones
  creadoEn  DateTime @default(now())
  autorId   Int
  autor     Usuario  @relation(fields: [autorId], references: [id])
}

model TicketSoporte {
  id          Int      @id @default(autoincrement())
  asunto      String
  descripcion String
  estado      String   @default("Abierto") // Abierto, Resuelto
  respuesta   String?  // Respuesta del administrador
  creadoEn    DateTime @default(now())
  voluntarioId Int
  voluntario  Voluntario @relation(fields: [voluntarioId], references: [id])
}

// Modelo para registrar actividad en el sistema (Logs para el Desarrollador)
model RegistroLog {
  id          Int      @id @default(autoincrement())
  accion      String
  pagina      String?
  detalles    String?
  usuarioId   Int?
  rolUsuario  String?
  creadoEn    DateTime @default(now())
}
