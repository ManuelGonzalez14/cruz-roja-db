generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Aquí definiremos las tablas de la base de datos
// Ejemplo: Tabla para registrar Voluntarios
model Voluntario {
  id          Int      @id @default(autoincrement())
  nombre          String
  segundoNombre   String?
  apellido        String
  segundoApellido String?
  cedula          String   @unique
  numeroCarnet    String?
  telefono    String?
  especialidad String?
  tipoSangre  String?
  alergias        String?
  fechaNacimiento DateTime?
  direccion       String?
  tallaUniforme   String?
  contactoEmergNombre    String?
  contactoEmergTelefono  String?
  activo          Boolean  @default(true)
  fotoUrl         String?
  creadoEn    DateTime @default(now())
  cursos      Curso[]
}

model Curso {
  id           Int        @id @default(autoincrement())
  nombre       String
  institucion  String     @default("Cruz Roja")
  fecha        DateTime?
  diplomaUrl   String?
  voluntarioId Int
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  creadoEn     DateTime   @default(now())
}

// Modelo para los administradores y usuarios del sistema
model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Aquí guardaremos la contraseña cifrada
  rol       String   @default("ADMIN") // Ejemplo: ADMIN, DESARROLLADOR
  creadoEn  DateTime @default(now())
}

// Modelo para registrar las mejoras e ideas del desarrollador
model Mejora {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  estado      String   @default("Pendiente") // Pendiente, En Progreso, Completado
  creadoEn    DateTime @default(now())
}
